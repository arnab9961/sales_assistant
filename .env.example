# Application Configuration
APP_NAME="AI Sales Operations Assistant"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Privacy & Anonymization
# When true, real client and employee names are replaced with stable pseudonyms (Exec-01, Client-0001, etc.)
ANONYMIZE_NAMES=true

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_in_production
POSTGRES_DB=sales_ops
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres_password_change_in_production@db:5432/sales_ops

# Read-only Analytics Role
DATABASE_RO_URL=postgresql+psycopg2://analytics_ro:analytics_ro_password@db:5432/sales_ops

# AI & LLM Service (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Webhook Security
# Shared secret for authenticating inbound webhook calls (X-API-Key)
WEBHOOK_API_KEY=change_me_webhook_secret_key_12345

# Optional outbound webhook URL to notify external automation (e.g. n8n)
N8N_WEBHOOK_URL=
